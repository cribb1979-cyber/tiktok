# Supabase (publikt anon-läsbar nyckel, säkert i klienten)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side-nyckel för Claude API (Netlify Edge Function: netlify/edge-functions/generate-plan.ts).
# Sätts som miljövariabel i Netlify (Site settings → Environment variables), inte här lokalt.
CLAUDE_API_KEY=

# Server-side-nycklar som läggs till i senare steg:
# SHOTSTACK_API_KEY=
# WHISPER_API_KEY=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
