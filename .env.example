# Supabase (publikt anon-läsbar nyckel, säkert i klienten)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side-nycklar för Netlify Edge Functions. Sätts som miljövariabler i Netlify
# (Site settings → Environment variables), inte här lokalt.
CLAUDE_API_KEY=
# OpenAI API-nyckel. Används av netlify/edge-functions/transcribe.ts (whisper-1) och
# embed-text.ts (text-embedding-3-small, för pgvector-retrieval).
WHISPER_API_KEY=
# Shotstack (rendering). SHOTSTACK_ENV=stage (default, gratis sandbox med vattenstämpel)
# eller v1 (produktion, kräver betald Shotstack-nyckel av samma typ).
SHOTSTACK_API_KEY=
SHOTSTACK_ENV=stage

# Valfritt tillval: AI-genererad B-roll (netlify/edge-functions/generate-broll.ts), via
# Replicate (Wan 2.1 — billig, open source). REPLICATE_MODEL styr modell, default
# "wan-video/wan-2.1-1.3b" (mindre 1.3B-modell, inget negative_prompt/fast_mode-stöd).
# Alternativ: "wavespeedai/wan-2.1-t2v-720p" (14B, bättre kvalitet, stödjer
# negative_prompt/fast_mode) — hade driftstopp hos WaveSpeedAI 2026-09-10, byt tillbaka om
# det löst sig och du vill ha bättre kvalitet.
# REPLICATE_API_TOKEN=
# REPLICATE_MODEL=wan-video/wan-2.1-1.3b

# Valfritt tillval: Manus-läge (dialog → AI-avatar-video), via HeyGen — se README
# "Manus-läge" för leverantörsvalet. HEYGEN_AVATAR_ID/HEYGEN_VOICE_ID väljs en gång i HeyGens
# dashboard/API, ingen väljar-UI i appen än.
# HEYGEN_API_KEY=
# HEYGEN_AVATAR_ID=
# HEYGEN_VOICE_ID=

# Server-side-nycklar som läggs till i senare steg:
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
